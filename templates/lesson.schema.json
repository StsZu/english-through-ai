{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lesson.schema.json",
  "title": "English Through AI — lesson data",
  "type": "object",
  "required": ["week", "title", "source", "duration_min", "objectives",
               "vocabulary", "reading", "audio", "quiz",
               "speaking_prompts", "homework"],
  "additionalProperties": false,
  "properties": {
    "week": { "type": "string", "pattern": "^w(NN|[0-9]{2})$" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "duration_min": { "type": "integer", "minimum": 1 },
    "objectives": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "definition_b1", "collocations", "ua", "source_sentence"],
        "additionalProperties": false,
        "properties": {
          "term": { "type": "string", "minLength": 1 },
          "definition_b1": { "type": "string", "minLength": 1 },
          "collocations": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": { "type": "string" }
          },
          "ua": { "type": "string" },
          "source_sentence": { "type": "string" }
        }
      }
    },
    "reading": {
      "type": "object",
      "required": ["b1", "original"],
      "additionalProperties": false,
      "properties": {
        "b1": { "type": "string" },
        "original": { "type": "string" }
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "src", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "src": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "quiz": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "prompt", "term_refs", "options"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^q[0-9]+$" },
          "prompt": { "type": "string", "minLength": 1 },
          "term_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["id", "text", "correct", "feedback"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "enum": ["a", "b", "c"] },
                "text": { "type": "string", "minLength": 1 },
                "correct": { "type": "boolean" },
                "feedback": { "type": "string", "minLength": 1 }
              }
            },
            "contains": {
              "type": "object",
              "properties": { "correct": { "const": true } },
              "required": ["correct"]
            }
          }
        }
      }
    },
    "speaking_prompts": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "homework": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
