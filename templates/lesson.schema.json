{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "lesson.schema.json",
  "title": "English Through AI — lesson data",
  "$comment": "Living documentation of the lesson format (T-002). Not executed: validation is hand-rolled in scripts/build_lesson.py so the repo runs on a clean Python 3 with zero dependencies. Rules the schema cannot express: exactly one correct option; note max 25 words; explanation 80-150 words; term_refs must exist in vocabulary; a real lesson has exactly 10 quiz questions (the build warns on any other count).",
  "type": "object",
  "required": [
    "week",
    "title",
    "source",
    "duration_min",
    "objectives",
    "vocabulary",
    "reading",
    "audio",
    "quiz",
    "speaking_prompts",
    "homework"
  ],
  "additionalProperties": false,
  "properties": {
    "week": {
      "type": "string",
      "pattern": "^w(NN|[0-9]{2})$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "duration_min": {
      "type": "integer",
      "minimum": 1
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term",
          "definition_b1",
          "collocations",
          "ua",
          "source_sentence"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "definition_b1": {
            "type": "string",
            "minLength": 1
          },
          "collocations": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          },
          "ua": {
            "type": "string"
          },
          "source_sentence": {
            "type": "string"
          },
          "example": {
            "type": "string",
            "description": "Optional. One sentence placing the term in the learner's own context. Rendered on the back of the flip card when present."
          }
        }
      }
    },
    "reading": {
      "type": "object",
      "required": [
        "b1",
        "original"
      ],
      "additionalProperties": false,
      "properties": {
        "b1": {
          "type": "string"
        },
        "original": {
          "type": "string"
        }
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "src",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "quiz": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "prompt",
          "term_refs",
          "options",
          "explanation"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^q[0-9]+$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "term_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "options": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "correct",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "a",
                    "b",
                    "c"
                  ],
                  "description": "Stable handle for this option, referenced by {{opt:<id>}} tokens. Stored order is a/b/c by position, but the rendered order is shuffled."
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "correct": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string",
                  "minLength": 1,
                  "$comment": "Short verdict line, 1-25 words, shown next to the option after answering.",
                  "description": "Max 25 words, measured after {{opt:...}} tokens expand. May use the same option tokens as explanation."
                }
              }
            },
            "contains": {
              "type": "object",
              "properties": {
                "correct": {
                  "const": true
                }
              },
              "required": [
                "correct"
              ]
            }
          },
          "explanation": {
            "type": "string",
            "minLength": 1,
            "$comment": "80-150 words, CEFR B1. Explains the correct answer, briefly why the other two are wrong, and adds one new fact, example or nuance not in the question.",
            "description": "80-120 words, measured after {{opt:...}} tokens expand. Options are shuffled at render time, so an option is referenced with a token naming its id - {{opt:b}} renders as the ordinal that option currently occupies ('second'), {{opt:b,c}} renders as 'second and third' in ascending display order. Naming an option by position in prose is rejected by the build."
          }
        }
      },
      "description": "Exactly 10 questions in a finished lesson (3 easy, 5 medium, 2 hard). The correct option must occupy each of the three positions 3-4 times; build_lesson.py fails the build if one position holds more than half of the correct answers."
    },
    "speaking_prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "homework": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pronunciation_focus": {
      "type": "array",
      "description": "Optional. Rendered as its own Pronunciation section between Vocabulary and Reading, and the source of homework item 2. Omitted entirely when the week has none.",
      "items": {
        "type": "object",
        "required": [
          "word",
          "stress",
          "why"
        ],
        "properties": {
          "word": {
            "type": "string"
          },
          "stress": {
            "type": "string",
            "description": "The word with the stressed syllable in CAPITALS, e.g. in-TEL-li-gence"
          },
          "why": {
            "type": "string",
            "description": "One sentence naming the problem for this learner"
          }
        }
      }
    }
  }
}
